# Copie este arquivo para .env e ajuste os valores

# Browser
HEADLESS=true
SLOW_MO=80

# Timing (segundos)
PAGE_WAIT_MIN=4
PAGE_WAIT_MAX=7
SCROLL_DELAY_SECONDS=3
CLICK_DELAY_MIN=0.8
CLICK_DELAY_MAX=2.0

# Scroll contínuo: para quando a altura não cresce por N rounds consecutivos
MAX_SCROLL_ATTEMPTS=200
STABLE_SCROLL_ROUNDS=3

# Limites de coleta
MAX_POSTS_PER_PAGE=100
MAX_COMMENT_EXPAND_PER_ARTICLE=50
MAX_REPLY_EXPAND_PER_COMMENT=20
MAX_RETRIES=3
RETRY_DELAY_SECONDS=10
SKIP_RECENT_EMPTY_HOURS=24
RESTART_BROWSER_EVERY_POSTS=0
COLLECT_ALBUM_PHOTOS=true

# Modo contínuo: volta ao primeiro link após concluir todos
CONTINUOUS_MODE=true
CONTINUOUS_INTERVAL_MINUTES=60

# Proxy (opcional — deixe comentado se não usar)
# PROXY_SERVER=http://proxy.example.com:8080
# PROXY_USERNAME=usuario
# PROXY_PASSWORD=senha
